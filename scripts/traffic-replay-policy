#!/usr/bin/env bash
set -euo pipefail

resolve_script_path() {
  local source="${BASH_SOURCE[0]}"
  while [ -L "$source" ]; do
    local dir
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    if [[ "$source" != /* ]]; then
      source="$dir/$source"
    fi
  done
  local dir
  dir="$(cd -P "$(dirname "$source")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$source")"
}

SCRIPT_PATH="$(resolve_script_path)"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CALLER_CWD="$(pwd)"
unset BASH_ENV ENV TRAFFIC_RECORDER_PROXY_BIN

find_proxy_binary() {
  local sibling_candidate="$SCRIPT_DIR/traffic-recorder-proxy"
  local repo_candidate="$REPO_ROOT/target/debug/traffic-recorder-proxy"
  local cwd_candidate="$CALLER_CWD/target/debug/traffic-recorder-proxy"

  if command -v traffic-recorder-proxy >/dev/null 2>&1; then
    command -v traffic-recorder-proxy
    return
  fi
  if [ -x "$sibling_candidate" ]; then
    printf '%s\n' "$sibling_candidate"
    return
  fi
  if [ -x "$cwd_candidate" ]; then
    printf '%s\n' "$cwd_candidate"
    return
  fi
  if [ -x "$repo_candidate" ]; then
    printf '%s\n' "$repo_candidate"
    return
  fi
  echo "traffic-recorder-proxy command not found on PATH" >&2
  exit 1
}

PROXY_BIN="$(find_proxy_binary)"
exec env -u BASH_ENV -u ENV "$PROXY_BIN" replay-policy "$@"
