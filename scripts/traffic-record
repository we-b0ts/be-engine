#!/usr/bin/env bash
set -euo pipefail

resolve_script_path() {
  local source="${BASH_SOURCE[0]}"
  while [ -L "$source" ]; do
    local dir
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    if [[ "$source" != /* ]]; then
      source="$dir/$source"
    fi
  done
  local dir
  dir="$(cd -P "$(dirname "$source")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$source")"
}

SCRIPT_PATH="$(resolve_script_path)"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$ROOT_DIR"
unset BASH_ENV ENV

usage() {
  cat >&2 <<EOF
Usage:
  traffic-record --config recorder-config.toml [options] [-- extra traffic-recorder-proxy args...]

Options:
  --config PATH    Recorder TOML configuration. Required.
  --dns            Enable local DNS capture and fake-IP TCP/UDP redirect. This is default.
  --no-dns         Skip local DNS capture and fake-IP TCP/UDP redirect.
  --user USER      Limit capture to this Unix user. Defaults to [local_record].record_user.
  --owner-uid UID  Limit capture to this numeric Unix uid.
  --all-users      Capture all local users. Use only on isolated machines.

DNS/fake-IP rules are automatically removed when this script exits.
CLI owner options override OWNER_UID, which overrides [local_record].
EOF
}

ENABLE_DNS=1
CONFIG=""
OWNER_MODE="config"
OWNER_USER_OVERRIDE=""
OWNER_UID_OVERRIDE=""
APP_ARGS=()

need_value() {
  local option="$1"
  local value="${2:-}"
  if [ -z "$value" ]; then
    echo "$option requires a value" >&2
    exit 2
  fi
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --config)
      need_value "$1" "${2:-}"
      if [ -n "$CONFIG" ]; then
        echo "--config may only be specified once" >&2
        exit 2
      fi
      CONFIG="$2"
      shift 2
      ;;
    --dns)
      ENABLE_DNS=1
      shift
      ;;
    --no-dns)
      ENABLE_DNS=0
      shift
      ;;
    --user)
      need_value "$1" "${2:-}"
      OWNER_MODE="user"
      OWNER_USER_OVERRIDE="$2"
      OWNER_UID_OVERRIDE=""
      shift 2
      ;;
    --owner-uid)
      need_value "$1" "${2:-}"
      OWNER_MODE="uid"
      OWNER_UID_OVERRIDE="$2"
      OWNER_USER_OVERRIDE=""
      shift 2
      ;;
    --all-users)
      OWNER_MODE="all"
      OWNER_USER_OVERRIDE=""
      OWNER_UID_OVERRIDE=""
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      APP_ARGS+=("$@")
      break
      ;;
    *)
      echo "unknown option or positional argument: $1" >&2
      usage
      exit 2
      ;;
  esac
done

if [ -z "$CONFIG" ]; then
  echo "--config is required" >&2
  usage
  exit 2
fi

if [ ! -f "$CONFIG" ]; then
  echo "recorder config not found: $CONFIG" >&2
  exit 1
fi

export RUST_LOG="${RUST_LOG:-info}"

load_local_record_config() {
  if ! command -v python3 >/dev/null 2>&1; then
    echo "python3 is required to read [local_record] from $CONFIG" >&2
    exit 1
  fi

  mapfile -t local_record_values < <(python3 - "$CONFIG" <<'PY'
import sys

try:
    import tomllib
except ModuleNotFoundError:
    sys.stderr.write("tomllib is required; use Python 3.11+ to read recorder TOML config.\n")
    raise SystemExit(1)

path = sys.argv[1]
with open(path, "rb") as fh:
    config = tomllib.load(fh)
local_record = config.get("local_record", {})

def value(name, default=""):
    item = local_record.get(name, default)
    if isinstance(item, bool):
        return "1" if item else "0"
    return str(item)

print(value("enabled", False))
print(value("record_user"))
print(value("owner_uid"))
PY
)

  LOCAL_RECORD_ENABLED="${local_record_values[0]}"
  LOCAL_RECORD_USER="${local_record_values[1]}"
  LOCAL_RECORD_OWNER_UID="${local_record_values[2]}"
}

uid_for_user() {
  local user="$1"
  if [ -z "$user" ]; then
    echo "user name is required" >&2
    exit 2
  fi
  if ! id -u "$user" 2>/dev/null; then
    cat >&2 <<EOF
record user not found: $user
Create it with:
  sudo useradd --system --create-home --shell /bin/bash $user
EOF
    exit 1
  fi
}

resolve_owner_uid() {
  if [ "$OWNER_MODE" = "all" ]; then
    export OWNER_UID=""
    return
  fi

  if [ "$OWNER_MODE" = "uid" ]; then
    export OWNER_UID="$OWNER_UID_OVERRIDE"
    return
  fi

  if [ "$OWNER_MODE" = "user" ]; then
    OWNER_UID="$(uid_for_user "$OWNER_USER_OVERRIDE")"
    export OWNER_UID
    return
  fi

  if [ -n "${OWNER_UID:-}" ]; then
    export OWNER_UID
    return
  fi

  LOCAL_RECORD_ENABLED=1
  LOCAL_RECORD_USER="trp-record"
  LOCAL_RECORD_OWNER_UID=""
  load_local_record_config

  if [ "$LOCAL_RECORD_ENABLED" != "1" ]; then
    export OWNER_UID=""
    return
  fi

  if [ -n "$LOCAL_RECORD_OWNER_UID" ]; then
    export OWNER_UID="$LOCAL_RECORD_OWNER_UID"
    return
  fi

  if [ -z "$LOCAL_RECORD_USER" ]; then
    echo "[local_record] is enabled but neither record_user nor owner_uid is set in $CONFIG" >&2
    exit 1
  fi

  OWNER_UID="$(uid_for_user "$LOCAL_RECORD_USER")"
  export OWNER_UID
}

if [ "$ENABLE_DNS" -eq 1 ]; then
  resolve_owner_uid
else
  export OWNER_UID="${OWNER_UID:-}"
fi

if ! command -v cargo >/dev/null 2>&1; then
  if [ -x "$HOME/.cargo/bin/cargo" ]; then
    export PATH="$HOME/.cargo/bin:$PATH"
  else
    echo "cargo not found. Install Rust first, or source \$HOME/.cargo/env." >&2
    exit 1
  fi
fi

run_args=(-- --config "$CONFIG" "${APP_ARGS[@]}")

if ! cargo watch --version >/dev/null 2>&1; then
  echo "cargo-watch is not installed; installing with: cargo install cargo-watch" >&2
  if ! cargo install cargo-watch; then
    echo "failed to install cargo-watch" >&2
    exit 1
  fi
fi

run_as_root() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  else
    if ! command -v sudo >/dev/null 2>&1; then
      echo "sudo not found; --dns setup requires root privileges" >&2
      exit 1
    fi
    sudo env \
      "DNS_IP=${DNS_IP:-127.0.0.153}" \
      "DNS_PORT=${DNS_PORT:-15353}" \
      "UPSTREAM_DNS=${UPSTREAM_DNS:-10.10.10.10:53}" \
      "FAKE_CIDR=${FAKE_CIDR:-198.18.0.0/15}" \
      "ENABLE_TCP=1" \
      "ENABLE_UDP=${ENABLE_UDP:-1}" \
      "GATEWAY_PORT=${GATEWAY_PORT:-15001}" \
      "UDP_GATEWAY_PORT=${UDP_GATEWAY_PORT:-15002}" \
      "OWNER_UID=$OWNER_UID" \
      "$@"
  fi
}

DNS_CAPTURE_UP=0
FAKE_REDIRECT_UP=0
WATCH_PID=""
WATCH_SESSION_ID=""

session_is_running() {
  local session_id="$1"
  [ -n "$session_id" ] && pgrep -s "$session_id" -f '.' >/dev/null 2>&1
}

collect_descendant_session_ids() {
  local parent_pid="$1"
  local child_pid
  local session_id

  while IFS= read -r child_pid; do
    if [ -z "$child_pid" ]; then
      continue
    fi
    session_id="$(ps -o sid= -p "$child_pid" 2>/dev/null | tr -d ' ')"
    if [ -n "$session_id" ]; then
      printf '%s\n' "$session_id"
    fi
    collect_descendant_session_ids "$child_pid"
  done < <(pgrep -P "$parent_pid" 2>/dev/null || true)
}

stop_watch_session() {
  local attempt
  local running
  local session_id
  local -a session_ids=()

  if [ -z "$WATCH_PID" ]; then
    return
  fi

  # cargo-watch starts the recorder command in its own process group. Run the
  # watcher in a dedicated session so cleanup can stop every process group it
  # created, including a recorder that outlived cargo-watch itself.
  mapfile -t session_ids < <(
    {
      printf '%s\n' "$WATCH_SESSION_ID"
      collect_descendant_session_ids "$WATCH_PID"
    } | sort -u
  )

  for session_id in "${session_ids[@]}"; do
    if [ "$session_id" != "$WATCH_SESSION_ID" ]; then
      pkill -INT -s "$session_id" -f '.' 2>/dev/null || true
    fi
  done

  # Give the recorder's SIGINT handler time to flush the active run before
  # stopping cargo-watch. Escalate only if a child session does not exit.
  for ((attempt = 0; attempt < 30; attempt++)); do
    running=0
    for session_id in "${session_ids[@]}"; do
      if [ "$session_id" != "$WATCH_SESSION_ID" ] && session_is_running "$session_id"; then
        running=1
        break
      fi
    done
    if [ "$running" -eq 0 ]; then
      break
    fi
    sleep 0.1
  done

  kill -TERM "$WATCH_PID" 2>/dev/null || true
  for session_id in "${session_ids[@]}"; do
    if session_is_running "$session_id"; then
      pkill -TERM -s "$session_id" -f '.' 2>/dev/null || true
    fi
  done

  for ((attempt = 0; attempt < 20; attempt++)); do
    running=0
    for session_id in "${session_ids[@]}"; do
      if session_is_running "$session_id"; then
        running=1
        break
      fi
    done
    if [ "$running" -eq 0 ]; then
      break
    fi
    sleep 0.1
  done

  for session_id in "${session_ids[@]}"; do
    if session_is_running "$session_id"; then
      pkill -KILL -s "$session_id" -f '.' 2>/dev/null || true
    fi
  done
  wait "$WATCH_PID" 2>/dev/null || true
}

cleanup_dns() {
  local exit_code=$?
  trap - EXIT HUP INT TERM
  set +e
  stop_watch_session
  if [ "$ENABLE_DNS" -eq 1 ]; then
    if [ "$FAKE_REDIRECT_UP" -eq 1 ]; then
      run_as_root "$ROOT_DIR/scripts/setup_fake_ip_redirect.sh" down
    fi
    if [ "$DNS_CAPTURE_UP" -eq 1 ]; then
      run_as_root "$ROOT_DIR/scripts/setup_local_dns.sh" down
    fi
  fi
  exit "$exit_code"
}

trap cleanup_dns EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if [ "$ENABLE_DNS" -eq 1 ]; then
  if [ -n "$OWNER_UID" ]; then
    echo "local recording owner filter enabled: OWNER_UID=$OWNER_UID" >&2
  fi
  run_as_root "$ROOT_DIR/scripts/setup_local_dns.sh" up
  DNS_CAPTURE_UP=1
  run_as_root "$ROOT_DIR/scripts/setup_fake_ip_redirect.sh" up
  FAKE_REDIRECT_UP=1
fi

setsid cargo watch \
  --watch src \
  --watch tests \
  --watch Cargo.toml \
  --watch Cargo.lock \
  --watch "$CONFIG" \
  --exec "run ${run_args[*]}" &
WATCH_PID=$!
WATCH_SESSION_ID="$WATCH_PID"

if wait "$WATCH_PID"; then
  WATCH_EXIT_CODE=0
else
  WATCH_EXIT_CODE=$?
fi
exit "$WATCH_EXIT_CODE"
