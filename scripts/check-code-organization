#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

limit=1000
warn=600
failed=0
scope="changed"
file_label="changed file"

usage() {
  cat <<'EOF'
Usage: scripts/check-code-organization [--all]

  no arguments  Check changed and untracked Rust product files.
  --all         Check every tracked and untracked Rust product file.
EOF
}

case "${1:-}" in
  "") ;;
  --all) scope="all" ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

if [ "$#" -gt 1 ]; then
  usage >&2
  exit 2
fi

changed_files() {
  {
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      if [ -n "${CODE_ORG_BASE:-}" ] && git rev-parse --verify "$CODE_ORG_BASE" >/dev/null 2>&1; then
        base="$CODE_ORG_BASE"
        git diff --name-only --diff-filter=ACMRTUXB "$base"...HEAD -- 'src/**/*.rs' 'src/*.rs'
      fi
      git diff --name-only --diff-filter=ACMRTUXB -- 'src/**/*.rs' 'src/*.rs'
      git diff --cached --name-only --diff-filter=ACMRTUXB -- 'src/**/*.rs' 'src/*.rs'
      git ls-files --others --exclude-standard -- 'src/**/*.rs' 'src/*.rs'
    else
      find src -type f -name '*.rs'
    fi
  } | sort -u
}

all_files() {
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git ls-files --cached --others --exclude-standard -- 'src/**/*.rs' 'src/*.rs'
  else
    find src -type f -name '*.rs'
  fi | sort -u
}

if [ "$scope" = "all" ]; then
  files="$(all_files)"
  file_label="product file"
else
  files="$(changed_files)"
fi

if [ -z "$files" ]; then
  echo "code organization check: no ${scope} Rust product source files"
  exit 0
fi

while IFS= read -r file; do
  [ -z "$file" ] && continue
  [ -f "$file" ] || continue
  lines="$(wc -l <"$file" | tr -d ' ')"
  if [ "$lines" -gt "$limit" ]; then
    echo "ERROR: $file_label $file has $lines lines; product source files must stay <= $limit lines" >&2
    failed=1
  elif [ "$lines" -gt "$warn" ]; then
    echo "WARN: $file_label $file has $lines lines; review whether responsibilities should be split" >&2
  fi
done <<<"$files"

exit "$failed"
