#!/usr/bin/env bash
set -euo pipefail

resolve_script_path() {
  local source="${BASH_SOURCE[0]}"
  while [ -L "$source" ]; do
    local dir
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    if [[ "$source" != /* ]]; then
      source="$dir/$source"
    fi
  done
  local dir
  dir="$(cd "$(dirname "$source")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$source")"
}

SCRIPT_PATH="$(resolve_script_path)"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

usage() {
  cat >&2 <<'EOF'
Usage:
  traffic-replay-target [options] -- <prebuilt-command> [args...]

Options:
  --copy-env NAME=PATH  Copy one read-only file or directory into the private
                        staging area and set NAME to its staged path. Repeatable.
  --path-env NAME=PATH  Set NAME to an existing path after verifying that the
                        fixed target user can read it. Repeatable.
  --env NAME=VALUE      Set one non-reserved target environment value. Repeatable.
  --write-dir PATH      Create one writable directory below the private target
                        working directory. PATH must be relative. Repeatable.
  -h, --help            Show this help.

The target command is copied into a private staging area, then executed as the
recorder-owned fixed interception user returned by
`traffic-replay --print-intercept-user`. The caller must already have
non-interactive sudo permission for staging ownership and for running commands
as that user. Build tools, traffic-replay, and traffic-replay-cli must remain
under the caller account.

This command never accepts a username or UID and never grants the target access
to the replay session, report, control socket, or replay CA private key.
EOF
}

fail() {
  echo "traffic-replay-target: $*" >&2
  exit 2
}

validate_assignment() {
  local option="$1"
  local assignment="$2"
  if [[ "$assignment" != *=* ]]; then
    fail "$option requires NAME=VALUE"
  fi
  local name="${assignment%%=*}"
  if [[ ! "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    fail "$option has an invalid environment name: $name"
  fi
  case "$name" in
    HOME|USER|LOGNAME|TMPDIR|PATH|PWD|SHELL|BASH_ENV|ENV|TRP_REPLAY_SESSION|SUDO_*)
      fail "$option cannot set reserved environment variable $name"
      ;;
  esac
}

declare -a COPY_ENV_VALUES=()
declare -a PATH_ENV_VALUES=()
declare -a TARGET_ENV_VALUES=()
declare -a WRITE_DIRS=()
declare -A ENV_NAMES=()

remember_assignment() {
  local option="$1"
  local assignment="$2"
  validate_assignment "$option" "$assignment"
  local name="${assignment%%=*}"
  if [[ -n "${ENV_NAMES[$name]:-}" ]]; then
    fail "environment variable $name was supplied more than once"
  fi
  ENV_NAMES["$name"]="$option"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --copy-env)
      [ "$#" -ge 2 ] || fail "$1 requires NAME=PATH"
      remember_assignment "$1" "$2"
      COPY_ENV_VALUES+=("$2")
      shift 2
      ;;
    --path-env)
      [ "$#" -ge 2 ] || fail "$1 requires NAME=PATH"
      remember_assignment "$1" "$2"
      PATH_ENV_VALUES+=("$2")
      shift 2
      ;;
    --env)
      [ "$#" -ge 2 ] || fail "$1 requires NAME=VALUE"
      remember_assignment "$1" "$2"
      TARGET_ENV_VALUES+=("$2")
      shift 2
      ;;
    --write-dir)
      [ "$#" -ge 2 ] || fail "$1 requires a relative path"
      WRITE_DIRS+=("$2")
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      fail "unknown option: $1"
      ;;
  esac
done

[ "$#" -gt 0 ] || fail "a prebuilt target command is required after --"

find_replay_command() {
  if command -v traffic-replay >/dev/null 2>&1; then
    command -v traffic-replay
  elif [ -x "$SCRIPT_DIR/traffic-replay" ]; then
    printf '%s\n' "$SCRIPT_DIR/traffic-replay"
  else
    fail "traffic-replay is not available on PATH or beside this command"
  fi
}

resolve_command() {
  local command_name="$1"
  local resolved
  if [[ "$command_name" == */* ]]; then
    [ -f "$command_name" ] || fail "target command not found: $command_name"
    resolved="$(readlink -f "$command_name")"
  else
    resolved="$(command -v "$command_name" || true)"
    [ -n "$resolved" ] || fail "target command not found on PATH: $command_name"
    resolved="$(readlink -f "$resolved")"
  fi
  [ -f "$resolved" ] || fail "target command is not a regular file: $resolved"
  [ -x "$resolved" ] || fail "target command is not executable: $resolved"
  printf '%s\n' "$resolved"
}

REPLAY_COMMAND="$(find_replay_command)"
TARGET_USER="$($REPLAY_COMMAND --print-intercept-user)"
[ -n "$TARGET_USER" ] || fail "traffic-replay returned an empty interception user"
TARGET_UID="$(id -u "$TARGET_USER" 2>/dev/null)" \
  || fail "fixed interception user does not exist: $TARGET_USER"
TARGET_GID="$(id -g "$TARGET_USER")"

if [ "$(id -u)" -eq 0 ]; then
  command -v runuser >/dev/null 2>&1 \
    || fail "runuser is required when traffic-replay-target runs as root"
  root_do() {
    "$@"
  }
  target_do() {
    runuser -u "$TARGET_USER" -- "$@"
  }
else
  command -v sudo >/dev/null 2>&1 || fail "sudo is required"
  sudo -n true >/dev/null 2>&1 \
    || fail "the caller needs non-interactive sudo permission"
  sudo -n -u "$TARGET_USER" true >/dev/null 2>&1 \
    || fail "the caller needs non-interactive sudo permission for $TARGET_USER"
  root_do() {
    sudo -n "$@"
  }
  target_do() {
    sudo -n -u "$TARGET_USER" -- "$@"
  }
fi

TARGET_COMMAND="$(resolve_command "$1")"
shift
TARGET_ARGS=("$@")

STAGE_BASE="${TMPDIR:-/tmp}"
[ -d "$STAGE_BASE" ] || fail "temporary directory does not exist: $STAGE_BASE"
STAGE_DIR="$(mktemp -d "$STAGE_BASE/traffic-replay-target.XXXXXXXX")"
WORK_DIR="$STAGE_DIR/work"
INPUT_DIR="$STAGE_DIR/inputs"
BIN_DIR="$STAGE_DIR/bin"
STAGED_COMMAND="$BIN_DIR/target"

cleanup() {
  local status=$?
  trap - EXIT
  root_do rm -rf -- "$STAGE_DIR" >/dev/null 2>&1 || true
  exit "$status"
}
trap cleanup EXIT

mkdir -p "$BIN_DIR" "$INPUT_DIR" "$WORK_DIR/home" "$WORK_DIR/tmp"
cp -- "$TARGET_COMMAND" "$STAGED_COMMAND"
chmod 0750 "$STAGE_DIR" "$BIN_DIR" "$INPUT_DIR"
chmod 0550 "$STAGED_COMMAND"
chmod 0770 "$WORK_DIR" "$WORK_DIR/home" "$WORK_DIR/tmp"

for relative in "${WRITE_DIRS[@]}"; do
  [ -n "$relative" ] || fail "--write-dir cannot be empty"
  case "/$relative/" in
    //*|*/../*|*/./*) fail "--write-dir must be a normalized relative path: $relative" ;;
  esac
  destination="$WORK_DIR/$relative"
  mkdir -p "$destination"
  chmod 0770 "$destination"
done

declare -a EXEC_ENV=()
input_index=0
for assignment in "${COPY_ENV_VALUES[@]}"; do
  name="${assignment%%=*}"
  source_path="${assignment#*=}"
  [ -e "$source_path" ] || fail "--copy-env source does not exist: $source_path"
  if [ -L "$source_path" ]; then
    fail "--copy-env does not accept symbolic links: $source_path"
  fi
  source_path="$(readlink -f "$source_path")"
  if [ -d "$source_path" ] \
    && find "$source_path" -type l -print -quit | grep -q .; then
    fail "--copy-env directory contains a symbolic link: $source_path"
  fi
  input_index=$((input_index + 1))
  destination="$INPUT_DIR/$input_index"
  if [ -d "$source_path" ]; then
    cp -a -- "$source_path" "$destination"
    find "$destination" -type d -exec chmod 0750 {} +
    find "$destination" -type f -exec chmod 0640 {} +
  else
    cp -- "$source_path" "$destination"
    chmod 0640 "$destination"
  fi
  EXEC_ENV+=("$name=$destination")
done

for assignment in "${PATH_ENV_VALUES[@]}"; do
  name="${assignment%%=*}"
  source_path="${assignment#*=}"
  [ -e "$source_path" ] || fail "--path-env source does not exist: $source_path"
  source_path="$(readlink -f "$source_path")"
  target_do test -r "$source_path" \
    || fail "$TARGET_USER cannot read --path-env source: $source_path"
  if [ -d "$source_path" ]; then
    target_do test -x "$source_path" \
      || fail "$TARGET_USER cannot traverse --path-env source: $source_path"
  fi
  EXEC_ENV+=("$name=$source_path")
done

EXEC_ENV+=("${TARGET_ENV_VALUES[@]}")
root_do chgrp -R "$TARGET_GID" "$STAGE_DIR"

echo "replay target identity: user=$TARGET_USER uid=$TARGET_UID" >&2
target_do env -i \
  "HOME=$WORK_DIR/home" \
  "USER=$TARGET_USER" \
  "LOGNAME=$TARGET_USER" \
  "TMPDIR=$WORK_DIR/tmp" \
  "PATH=/usr/local/bin:/usr/bin:/bin" \
  "${EXEC_ENV[@]}" \
  /bin/sh -c '
    work_dir="$1"
    expected_uid="$2"
    shift 2
    if [ "$(id -u)" != "$expected_uid" ]; then
      echo "traffic-replay-target: effective UID does not match fixed interception user" >&2
      exit 126
    fi
    cd "$work_dir"
    exec "$@"
  ' traffic-replay-target "$WORK_DIR" "$TARGET_UID" "$STAGED_COMMAND" "${TARGET_ARGS[@]}"
