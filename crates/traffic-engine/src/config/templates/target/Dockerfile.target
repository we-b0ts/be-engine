FROM __TARGET_BUILDER_IMAGE__ AS builder

ENV CARGO_HOME=/opt/rust/cargo
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN --mount=type=cache,id=traffic-e2e-cargo-registry,target=/opt/rust/cargo/registry,sharing=locked \
    --mount=type=cache,id=traffic-e2e-template-target,target=/build/target,sharing=locked \
    cargo build --locked --release --bin traffic-e2e-target-template \
    && binary="$(find /build/target -type f -path '*/release/traffic-e2e-target-template' -print -quit)" \
    && test -n "${binary}" \
    && install --directory /out \
    && install --mode 0755 "${binary}" /out/traffic-e2e-target-template

FROM __TARGET_RUNTIME_IMAGE__
COPY --from=builder --chown=998:998 /out/traffic-e2e-target-template /app/bin/traffic-e2e-target-template
USER 0:0
RUN install --directory --owner=998 --group=998 --mode=0775 /data1/weibo/logs
USER 998:998
ENTRYPOINT ["/app/bin/traffic-e2e-target-template"]
